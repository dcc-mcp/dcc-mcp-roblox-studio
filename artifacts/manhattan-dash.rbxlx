ol name="Anchored">true</bool><Color3uint8 name="Color3uint8">4294937727</Color3uint8><CoordinateFrame name="CFrame"><X>-4</X><Y>9</Y><Z>48</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>8</Y><Z>1</Z></Vector3><float name="Reflectance">0.2</float></Properties></Item><Item class="Part" referent="RBX1825648E23360B2C67FA767A5BA460A8"><Properties><string name="Name">StreetSign_FifthAvenueNorth</string><bool name="Anchored">true</bool><Color3uint8 name="Color3uint8">4294937727</Color3uint8><CoordinateFrame name="CFrame"><X>74</X><Y>9</Y><Z>-94</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>8</Y><Z>1</Z></Vector3><float name="Reflectance">0.2</float></Properties></Item><Item class="Part" referent="RBX915F5939FF034A7E8E6C509CFBB2F913"><Properties><string name="Name">StreetSign_FifthAvenueMidtown</string><bool name="Anchored">true</bool><Color3uint8 name="Color3uint8">4294937727</Color3uint8><CoordinateFrame name="CFrame"><X>74</X><Y>9</Y><Z>-24</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>8</Y><Z>1</Z></Vector3><float name="Reflectance">0.2</float></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX40D778C116CE882C24687AABC9BDC7BF"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX82E0605558530BA3C9383F4C55ABC96D"><Properties><string name="Name">ManhattanDashGame</string><ProtectedString name="Source">local Players = game:GetService("Players")
local city = workspace:WaitForChild("ManhattanReplica")
local spawnPad = city:WaitForChild("SpawnPad")
local checkpoints = {
    city:WaitForChild("Checkpoint_1"),
    city:WaitForChild("Checkpoint_2"),
    city:WaitForChild("Checkpoint_3"),
}
local goal = city:WaitForChild("CentralParkBeacon")
local finishDebounce = {}

local function statsFor(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
        local blocks = Instance.new("IntValue")
        blocks.Name = "Blocks"
        blocks.Parent = stats
        local wins = Instance.new("IntValue")
        wins.Name = "Wins"
        wins.Parent = stats
    end
    return stats
end

local function teleportToProgress(player, character)
    local stage = statsFor(player).Blocks.Value
    local target = checkpoints[stage] or spawnPad
    character:PivotTo(target.CFrame + Vector3.new(0, 5, 0))
end

local function playerFromHit(hit)
    local character = hit and hit.Parent
    return character and Players:GetPlayerFromCharacter(character)
end

for index, checkpoint in ipairs(checkpoints) do
    checkpoint.Touched:Connect(function(hit)
        local player = playerFromHit(hit)
        if player then
            local stage = statsFor(player).Blocks
            stage.Value = math.max(stage.Value, index)
        end
    end)
end

goal.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if player and not finishDebounce[player] then
        finishDebounce[player] = true
        local stats = statsFor(player)
        stats.Wins.Value += 1
        stats.Blocks.Value = 0
        task.delay(1, function()
            finishDebounce[player] = nil
        end)
    end
end)

Players.PlayerAdded:Connect(function(player)
    statsFor(player)
    player.CharacterAdded:Connect(function(character)
        task.wait()
        teleportToProgress(player, character)
    end)
end)
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX8C3D410C7405454B7CFFA80D3D477DAC"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX576727195EB454A9F533590E5130CF89"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBXCEA18D1E320E59D3C95052F3AD906879"><Properties><string name="Name">ManhattanDashHUD</string><ProtectedString name="Source">local Players = game:GetService("Players")
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "ManhattanDashHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(0, 540, 0, 58)
title.Position = UDim2.new(0.5, -270, 0, 22)
title.BackgroundColor3 = Color3.fromRGB(18, 27, 45)
title.BackgroundTransparency = 0.08
title.TextColor3 = Color3.fromRGB(255, 220, 120)
title.Font = Enum.Font.GothamBlack
title.TextSize = 28
title.Text = "MANHATTAN DASH"
title.Parent = gui

local status = Instance.new("TextLabel")
status.Name = "Status"
status.Size = UDim2.new(0, 520, 0, 42)
status.Position = UDim2.new(0.5, -260, 0, 84)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(255, 255, 255)
status.Font = Enum.Font.Gotham
status.TextSize = 18
status.Parent = gui

local hint = Instance.new("TextLabel")
hint.Name = "Hint"
hint.Size = UDim2.new(0, 600, 0, 30)
hint.Position = UDim2.new(0.5, -300, 1, -48)
hint.BackgroundTransparency = 1
hint.TextColor3 = Color3.fromRGB(180, 210, 230)
hint.Font = Enum.Font.Gotham
hint.TextSize = 16
hint.Text = "Run north through Midtown, touch the beacons, reach Central Park."
hint.Parent = gui

local stats = player:WaitForChild("leaderstats")
local blocks = stats:WaitForChild("Blocks")
local wins = stats:WaitForChild("Wins")
local function refresh()
    status.Text = string.format("BLOCK %d/3    COMPLETIONS %d", blocks.Value, wins.Value)
end
blocks.Changed:Connect(refresh)
wins.Changed:Connect(refresh)
refresh()
</ProtectedString></Properties></Item></Item></Item></roblox>